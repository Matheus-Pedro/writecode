# Copie este arquivo para .env e preencha os valores desejados

# Chave de API para gerar trechos com IA (OpenAI ou compatível).
# Necessária apenas para a fonte "IA". Opcional.
OPENAI_API_KEY=

# URL base e modelo (valores padrão para OpenAI).
# Qualquer provedor compatível com a API OpenAI funciona (OpenAI, OpenRouter, Groq, etc).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Token opcional do GitHub para aumentar o limite de requisições da API.
# Opcional.
GITHUB_TOKEN=

# Porta do servidor backend.
PORT=3001

# URL pública do site (ex: https://writecode.com.br).
# Usada no canonical, Open Graph, sitemap e robots.txt. Obrigatória em produção.
APP_URL=
